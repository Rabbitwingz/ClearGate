<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Label under a bank icon in the 4x2 widget. -->
    <style name="WidgetBankLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_surface_variant</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Bank icon in the compact 4x1 widget. -->
    <style name="WidgetCompactBank">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
</resources>
