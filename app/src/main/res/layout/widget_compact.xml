<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget (4x1, used on Android 12+ when resized down): logo (dimmed while paused), bank icons, Add,
     Pause/Resume. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <ImageView
        android:id="@+id/bank_icon_0"
        style="@style/WidgetCompactBank"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bank_icon_1"
        style="@style/WidgetCompactBank"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bank_icon_2"
        style="@style/WidgetCompactBank"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bank_icon_3"
        style="@style/WidgetCompactBank"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bank_add"
        style="@style/WidgetCompactBank"
        android:background="@drawable/widget_add_slot"
        android:contentDescription="@string/widget_add_bank"
        android:padding="8dp"
        android:src="@drawable/ic_widget_add" />

    <!-- Spacer pushing the button to the end. Widgets can't use a plain View, so it's an empty FrameLayout. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_button"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="@string/widget_pause"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/widget_on_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
