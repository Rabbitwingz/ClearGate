<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (4x2): ClearGate's state and Pause/Resume button, then up to 4 banking apps that open with
     ClearGate paused, and an Add slot. Slots are shown or hidden from ClearGateWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_status_on"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/widget_pause"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/bank_slot_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/bank_icon_0"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/bank_label_0"
                style="@style/WidgetBankLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bank_slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/bank_icon_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/bank_label_1"
                style="@style/WidgetBankLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bank_slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/bank_icon_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/bank_label_2"
                style="@style/WidgetBankLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bank_slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/bank_icon_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/bank_label_3"
                style="@style/WidgetBankLabel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bank_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_add_slot"
                android:contentDescription="@string/widget_add_bank"
                android:padding="10dp"
                android:src="@drawable/ic_widget_add" />

            <TextView
                style="@style/WidgetBankLabel"
                android:text="@string/widget_add_bank" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
