<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (4x2): ClearGate's state and Pause/Resume button, then up to 4 banking apps that open with
     ClearGate paused, and an Add slot.

     Alignment: bank slots are a fixed 60dp with a 40dp icon centred (10dp inset), and the header is inset by the
     same 10dp, so the first bank icon sits under the logo and the last slot ends under the button's right edge.
     Between slots there's either a flexible spacer (spread to both edges, 3+ items) or a fixed gap (left-aligned,
     1-2 items); ClearGateWidget shows one or the other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_status_on"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_pause"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/bank_slot_0" style="@style/WidgetBankSlot">
            <ImageView android:id="@+id/bank_icon_0" style="@style/WidgetBankIcon" />
            <TextView android:id="@+id/bank_label_0" style="@style/WidgetBankLabel" />
        </LinearLayout>
        <FrameLayout android:id="@+id/bank_gap_0" style="@style/WidgetBankGap" />
        <FrameLayout android:id="@+id/bank_flex_0" style="@style/WidgetBankFlex" />

        <LinearLayout android:id="@+id/bank_slot_1" style="@style/WidgetBankSlot">
            <ImageView android:id="@+id/bank_icon_1" style="@style/WidgetBankIcon" />
            <TextView android:id="@+id/bank_label_1" style="@style/WidgetBankLabel" />
        </LinearLayout>
        <FrameLayout android:id="@+id/bank_gap_1" style="@style/WidgetBankGap" />
        <FrameLayout android:id="@+id/bank_flex_1" style="@style/WidgetBankFlex" />

        <LinearLayout android:id="@+id/bank_slot_2" style="@style/WidgetBankSlot">
            <ImageView android:id="@+id/bank_icon_2" style="@style/WidgetBankIcon" />
            <TextView android:id="@+id/bank_label_2" style="@style/WidgetBankLabel" />
        </LinearLayout>
        <FrameLayout android:id="@+id/bank_gap_2" style="@style/WidgetBankGap" />
        <FrameLayout android:id="@+id/bank_flex_2" style="@style/WidgetBankFlex" />

        <LinearLayout android:id="@+id/bank_slot_3" style="@style/WidgetBankSlot">
            <ImageView android:id="@+id/bank_icon_3" style="@style/WidgetBankIcon" />
            <TextView android:id="@+id/bank_label_3" style="@style/WidgetBankLabel" />
        </LinearLayout>
        <FrameLayout android:id="@+id/bank_gap_3" style="@style/WidgetBankGap" />
        <FrameLayout android:id="@+id/bank_flex_3" style="@style/WidgetBankFlex" />

        <LinearLayout
            android:id="@+id/bank_add"
            style="@style/WidgetBankSlot"
            android:visibility="visible">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_add_slot"
                android:contentDescription="@string/widget_add_bank"
                android:padding="10dp"
                android:src="@drawable/ic_widget_add" />

            <TextView
                style="@style/WidgetBankLabel"
                android:text="@string/widget_add_bank" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
